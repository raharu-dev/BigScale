# Generates a C++ header containing the compiled SM5 compute kernels as byte arrays.
# Invoked as: cmake -DPAIRS="name=path|name=path" -DOUTPUT=<header> -P gen_shaders.cmake
# The generated definitions are `inline const` (C++17) so the byte arrays exist once per program even
# when several translation units include the header, and still match the declarations in Shaders.h.

if(NOT DEFINED PAIRS OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "gen_shaders.cmake requires -DPAIRS and -DOUTPUT")
endif()

set(content "// Generated by gen_shaders.cmake. Do not edit.\n#pragma once\n\nnamespace bigscale\n{\n")

string(REPLACE "|" ";" entries "${PAIRS}")
foreach(entry IN LISTS entries)
  string(FIND "${entry}" "=" separator)
  if(separator EQUAL -1)
    message(FATAL_ERROR "Malformed shader entry '${entry}'")
  endif()
  math(EXPR nameLength "${separator}")
  string(SUBSTRING "${entry}" 0 ${nameLength} name)
  math(EXPR pathOffset "${separator} + 1")
  string(SUBSTRING "${entry}" ${pathOffset} -1 path)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing compiled shader '${path}'")
  endif()

  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hexLength)
  math(EXPR byteCount "${hexLength} / 2")

  string(APPEND content "inline const unsigned char k${name}Cso[] =\n{\n")
  math(EXPR lastIndex "${byteCount} - 1")
  set(line "   ")
  set(column 0)
  if(byteCount GREATER 0)
    foreach(index RANGE ${lastIndex})
      math(EXPR offset "${index} * 2")
      string(SUBSTRING "${hex}" ${offset} 2 byte)
      string(APPEND line " 0x${byte},")
      math(EXPR column "${column} + 1")
      if(column EQUAL 16)
        string(APPEND content "${line}\n")
        set(line "   ")
        set(column 0)
      endif()
    endforeach()
  endif()
  if(column GREATER 0)
    string(APPEND content "${line}\n")
  endif()
  string(APPEND content "};\ninline const unsigned int k${name}CsoSize = ${byteCount}u;\n\n")
endforeach()

string(APPEND content "}\n")
file(WRITE "${OUTPUT}" "${content}")
